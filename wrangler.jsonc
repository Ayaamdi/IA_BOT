{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ia-bot",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}